# HoofPrint - Root Git Ignore

# ENVIRONMENT & SECRETS
.env
.env.*
!.env.example

frontend/.env
frontend/.env.*
!frontend/.env.example

backend/.env
backend/.env.*
!backend/.env.example

# FRONTEND - VITE / REACT
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.vite/

# BACKEND - PYTHON / FASTAPI
backend/__pycache__/
backend/**/__pycache__/

*.py[cod]
*$py.class

backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/
backend/.coverage
backend/htmlcov/

# Python virtual environments
backend/venv/
backend/.venv/
backend/env/
backend/.env/

# PYTHON BUILD / PACKAGING
*.egg
*.egg-info/
dist/
build/
pip-wheel-metadata/

# LOGS
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
uvicorn.log

# TESTING / COVERAGE
coverage/
.nyc_output/
.pytest_cache/
test-results/
playwright-report/

# IDE / EDITORS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

.idea/
*.iml

*.swp
*.swo

# OS FILES
.DS_Store
Thumbs.db
desktop.ini

# CACHE / TEMPORARY FILES
.cache/
.vite/
.parcel-cache/
*.tmp
*.temp

# TYPESCRIPT
*.tsbuildinfo

# LOCAL / DEPLOYMENT
.vercel/
.netlify/

# DATABASE / LOCAL DATA
*.sqlite
*.sqlite3
*.db

# GENERATED / UPLOADED FILES
backend/uploads/
backend/tmp/
backend/temp/

# MODEL / ML GENERATED FILES
# Uncomment if these are generated rather than source-controlled
# backend/models/*.h5
# backend/models/*.keras
# backend/models/*.pkl
# backend/models/*.joblib

# JUPYTER
.ipynb_checkpoints/